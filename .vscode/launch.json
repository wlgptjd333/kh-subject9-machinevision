{
    // F5(디버그 실행) 때 "Select a debug configuration"을 묻지 않도록 기본 설정을 둡니다.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: 현재 파일 (프로젝트 최상위 기준)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            // samples/ 같은 상대경로가 동작하도록 프로젝트 최상위에서 실행
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
